# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, server only. Used to look up emails for notifications.
SUPABASE_SECRET_KEY=

# Public site URL, used for login redirects, sitemap and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: transactional email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="סמוך <no-reply@example.com>"
